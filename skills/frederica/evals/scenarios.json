        "title": "Scenario Screen Override",
        "source_tool": "codex",
        "tool_version": "",
        "model": "",
        "thinking_mode": "unknown",
        "project": "make-frederica",
        "session_date": "2026-03-17",
        "session_id": "",
        "tags": ["scenario"],
        "reusability_score": 80,
        "summary": "Scenario summary",
        "body_markdown": "# Overview\n\nScenario body."
